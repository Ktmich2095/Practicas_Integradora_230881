    "cards":  [
                  {
                      "dot":  "rose",
                      "title":  "Proposed trust model",
                      "items":  [
                                    "Initial design: OIDC authorization code + PKCE; API validates JWTs using cached Keycloak keys.",
                                    "Only the API accesses application databases. Responses return along the request paths."
                                ]
                  },
                  {
                      "dot":  "cyan",
                      "title":  "Maps integration",
                      "items":  [
                                    "Leaflet is a web map library: a Flutter WebView bridge or a native map integration is still to be chosen.",
                                    "The external maps provider is unspecified; Leaflet itself does not host map tiles."
                                ]
                  },
                  {
                      "dot":  "slate",
                      "title":  "Local development",
                      "items":  [
                                    "Proposed Compose stack: FastAPI, Keycloak, PostgreSQL and MongoDB in Docker; Flutter runs separately.",
                                    "Git / GitHub track source and Compose configuration. Production hosting and Keycloak persistence are TBD."
                                ]
                  }
